{ "id": "run-formatter-after-edit", "title": "Format files after an edit", "description": "Runs a formatter on each file Claude Code edits or writes. Needs jq.", "event": "PostToolUse", "matcher": "Edit|Write", "command": "jq -r '.tool_input.file_path' | xargs {{formatter}}", "timeout_s": 60, "params": [{ "name": "formatter", "label": "Formatter", "choices": ["prettier --write", "gofmt -w", "black"] }] }
