{
  "note": "Strings that must never appear in frames, logs, telemetry, crash reports or backups (CT-PROVIDER rule 1). Patterns are regexes (ECMAScript flavour).",
  "patterns": [
    {
      "id": "anthropic_api_key",
      "regex": "(?<![A-Za-z0-9_])sk-ant-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "id": "openai_api_key",
      "regex": "(?<![A-Za-z0-9_])sk-(proj-)?[A-Za-z0-9_\\-]{20,}"
    },
    {
      "id": "openai_oauth_access",
      "regex": "eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}"
    },
    {
      "id": "codex_auth_json",
      "regex": "\"(access_token|refresh_token|id_token)\"\\s*:\\s*\"[^\"]{20,}\""
    },
    {
      "id": "bearer_header",
      "regex": "[Aa]uthorization:\\s*Bearer\\s+[A-Za-z0-9._\\-]{20,}"
    },
    {
      "id": "aws_access_key",
      "regex": "AKIA[0-9A-Z]{16}"
    },
    {
      "id": "google_api_key",
      "regex": "AIza[0-9A-Za-z_\\-]{35}"
    }
  ],
  "must_match": [
    "sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAA",
    "sk-proj-AAAAAAAAAAAAAAAAAAAAAAAA",
    "Authorization: Bearer abcdefghijklmnopqrstuvwxyz0123456789",
    "AKIAABCDEFGHIJKLMNOP"
  ],
  "must_not_match": [
    "ses_01JA3Z8K2M5N7P9Q0R1S2T3V4W",
    "msg_01JA3Z8K2M5N7P9Q0R1S2T3V4W",
    "cen_live_Ab3kExample",
    "hello world",
    "task-management-system-overview-for-everyone",
    "risk-assessment-framework-document-v2"
  ]
}