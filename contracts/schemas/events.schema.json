{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centcom.dev/contracts/events.schema.json",
  "title": "Centcom session events (frame-level rules per kind)",
  "description": "Apply AFTER envelope.schema.json. `$defs.p_*` validate cleartext payloads; `$defs.s_*` validate the decrypted secret payload of encrypted/hybrid kinds.",
  "$defs": {
    "s_message_user": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "agent_id": {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "queue_item": {
          "type": "string",
          "pattern": "^que_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 200
        },
        "reply_to": {
          "type": "string",
          "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "text"
      ]
    },
    "s_message_assistant_delta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "delta": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "agent_id",
        "message_id",
        "index",
        "delta"
      ]
    },
    "s_message_assistant_done": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "agent_id",
        "message_id"
      ]
