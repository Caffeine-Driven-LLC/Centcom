            "handoff",
            "high-five",
            "host-session",
            "idle",
            "listening",
            "merge-conflict",
            "message-queued",
            "no-results",
            "offline",
            "online",
            "pair-working",
            "planning",
            "pr-merged",
            "pr-open",
            "prompt-received",
            "quota-reached",
            "rate-limited",
            "reading-file",
            "ready",
