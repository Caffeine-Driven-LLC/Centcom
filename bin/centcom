#!/bin/sh
# Starts Centcom in the folder you are in, like `claude`. Install once with `pnpm install:cli` (links this file as ~/.local/bin/centcom).
# It runs the checkout's sources, so a `git pull` is an update; run `pnpm install` in the checkout after dependencies change.
self="$0"
while [ -L "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd); self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
tsx="$root/node_modules/.bin/tsx"
if [ ! -x "$tsx" ]; then echo "centcom: dependencies are missing in $root. Run: pnpm install" >&2; exit 1; fi
export TSX_TSCONFIG_PATH="$root/tsconfig.json"
export CENTCOM_HOME_REPO="$root"
# Fast path: a bundle of the CLI (starts in ~0.3 s; tsx needs ~1.4 s to transpile the workspace every time) and React's production build
# (about twice as fast per keystroke). The bundle is rebuilt when a source file is newer than it. CENTCOM_DEV=1 runs the sources through tsx with React's dev warnings.
if [ -z "$CENTCOM_DEV" ]; then
  export NODE_ENV=production NODE_COMPILE_CACHE="$root/node_modules/.cache/centcom/v8" # V8 keeps its compiled code between runs
  bundle="$root/node_modules/.cache/centcom/cli.mjs"
  if [ ! -f "$bundle" ] || [ -n "$(find "$root/apps/cli/src" "$root"/packages/*/src "$root/pnpm-lock.yaml" "$root/tools/dev/bundle-cli.mjs" -newer "$bundle" \( -name '*.ts' -o -name '*.tsx' -o -name '*.json' -o -name "*.mjs" -o -name "pnpm-lock.yaml" \) -print -quit 2>/dev/null)" ]; then
    tmp="$bundle.$$.tmp"; node "$root/tools/dev/bundle-cli.mjs" "$tmp" >/dev/null 2>&1 && mv -f "$tmp" "$bundle" || rm -f "$tmp"
  fi
  if [ -f "$bundle" ]; then exec node "$bundle" "$@"; fi
fi
exec "$tsx" "$root/apps/cli/src/main.tsx" "$@"
