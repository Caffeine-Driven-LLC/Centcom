{
  "$comment": "Per-repository settings for the Claude PR pipeline (claude-pr-state.mjs, claude-prompts/). The scripts are identical in Centcom and Centcom-backend; only this file differs.",
  "lanePattern": "C\\d{3}",
  "laneCardDir": "plan/lanes/client",
  "requiredChecks": ["CI / Typecheck, test, build"],
  "titleCheck": null,
  "protectedPaths": [
    "contracts/",
    "plan/",
    ".github/",
    "tools/plan/",
    "tools/ci/",
    "pnpm-workspace.yaml",
    ".claude/",
    ".claude.json",
    ".mcp.json",
    ".husky/",
    ".gitmodules",
    ".ripgreprc",
    ".npmrc",
    ".pnpmfile.cjs",
    ".pnpmfile.mjs"
  ],
  "protectedNames": ["CLAUDE.md", "CLAUDE.local.md"],
  "laneOwnedPaths": ["plan/STATUS.json"],
  "gates": "`bash tools/ci/gates.sh` (every check CI runs, in order)",
  "execTools": [
    "Bash(pnpm install --frozen-lockfile)",
    "Bash(bash tools/ci/gates.sh)",
    "Bash(pnpm typecheck)",
    "Bash(pnpm test)",
    "Bash(pnpm test:*)",
    "Bash(pnpm web:build)"
  ],
  "mainWorkflows": ["ci.yml"]
}
