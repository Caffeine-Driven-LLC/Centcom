{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/*/src",
    "packages/*/src",
    "packages/*/test",
    "apps/*/test",
    "tools/conformance",
    "tools/release-gate"
  ],
  "compilerOptions": {
    "paths": {
      "@centcom/theme": [
        "./packages/theme/src/index.ts"
      ],
      "@centcom/mascot": [
        "./packages/mascot/src/index.ts"
      ],
      "@centcom/agent": [
        "./packages/agent/src/index.ts"
      ],
      "@centcom/skills": [
        "./packages/skills/src/index.ts"
      ],
      "@centcom/tui": [
        "./packages/tui/src/index.ts"
      ],
      "@centcom/models": [
        "./packages/agent/src/models.ts"
      ],
      "@centcom/commands": [
        "./packages/tui/src/state/commands.ts"
      ]
    }
  }
}