{
  "name": "centcom",
  "private": true,
  "version": "0.0.0",
  "description": "Centcom: command many hands. Terminal-first multiplayer for your own Claude Code and Codex.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "centcom": "tsx apps/cli/src/main.tsx",
    "dev": "tsx apps/cli/src/main.tsx --demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "plan:check": "python3 tools/plan/validate_plan.py && python3 tools/plan/validate_contracts.py && python3 tools/plan/lock.py --check",
    "web:build": "pnpm --filter @centcom/web split-animations && pnpm --filter @centcom/web exec vite build",
    "skills:sync": "tsx tools/skills/sync.ts",
    "changeset": "changeset",
    "release:meta": "node tools/release/build-meta.mjs",
    "dev:mock": "tsx tools/dev/mock.mjs",
    "bench": "tsx tools/bench/run.ts",
    "bench:compare": "tsx tools/bench/compare-cli.ts",
    "docs:gen": "tsx tools/docs/gen-cli-reference.ts",
    "docs:check": "tsx tools/docs/check.ts",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "vitepress build docs/site",
    "conformance": "tsx tools/conformance/run.ts",
    "release-gate": "tsx tools/release-gate/run.ts",
    "security:check": "tsx tools/security/run.ts",
    "sbom": "tsx tools/security/sbom-cli.ts",
    "web:dev": "pnpm --filter @centcom/web exec vite",
    "app:build": "pnpm web:build && pnpm --filter @centcom/desktop build",
    "app": "pnpm app:build && pnpm --filter @centcom/desktop start",
    "app:dev": "pnpm --filter @centcom/desktop build && pnpm --filter @centcom/desktop start",
    "app:smoke": "pnpm app:build && CENTCOM_SMOKE=1 pnpm --filter @centcom/desktop start",
    "app:mock": "CENTCOM_CODEX_BIN=\"$PWD/tools/codex/bin/codex\" pnpm app",
    "lanes:next": "node tools/dev/lane-tasks.mjs",
    "dogfood": "node tools/dev/lane-tasks.mjs --seed ; tsx apps/cli/src/main.tsx",
    "install:cli": "sh tools/dev/install-cli.sh",
    "onboard": "sh tools/dev/onboard.sh"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "ajv": "8.20.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "2.9.1"
  }
}
